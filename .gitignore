vendor/               # cloned reference implementations (e.g. llama.cpp builds)
.uv/
__pycache__/
*.py[cod]

# Compiled Mojo/native binaries and objects
*.o
*.so
*.dylib

# macOS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/
